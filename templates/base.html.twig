<!DOCTYPE html>
<html lang="fr" data-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}CampusEats{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍽️</text></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.0.6/css/pico.min.css">
        <style>
            .flash { padding: .75rem 1rem; border-radius: .4rem; margin-bottom: 1rem; }
            .flash-success { background: #d1f2dc; color: #14532d; }
            .flash-error { background: #fde2e1; color: #7f1d1d; }
            form.inline { display: inline; margin: 0; }
            form.inline button { width: auto; margin: 0; padding: .25rem .7rem; }
        </style>
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {# Turbo désactivé : navigation classique, plus simple avec les formulaires et Chart.js #}
    <body data-turbo="false">
        {{ include('_partials/_navbar.html.twig') }}
        <main class="container">
            {{ include('_partials/_flash.html.twig') }}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
