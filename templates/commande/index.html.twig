{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div class="container my-4">
    <h1 class="h3 mb-3">Mes commandes</h1>

    {% for commande in commandes %}
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>Commande n°{{ commande.id }}{% if commande.date is defined %} — {{ commande.date|date('d/m/Y') }}{% endif %}</span>
                {% if commande.statut is defined %}<span class="badge theme-primary">{{ commande.statut }}</span>{% endif %}
            </div>
            <div class="card-body">
                {% if commande.lignes is defined and commande.lignes is not empty %}
                    <table class="table mb-0">
                        <thead>
                            <tr><th>Plat</th><th class="text-end">Qté</th><th class="text-end">Prix</th></tr>
                        </thead>
                        <tbody>
                            {% for ligne in commande.lignes %}
                                <tr>
                                    <td>{{ ligne.plat.nom ?? ligne.plat }}</td>
                                    <td class="text-end">{{ ligne.quantite ?? 1 }}</td>
                                    <td class="text-end">{{ (ligne.prix ?? 0)|number_format(2, ',', ' ') }} €</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
                {% if commande.total is defined %}
                    <p class="text-end fw-bold mt-2 mb-0">Total : {{ commande.total|number_format(2, ',', ' ') }} €</p>
                {% endif %}
            </div>
        </div>
    {% else %}
        <p>Vous n'avez pas encore passé de commande.</p>
    {% endfor %}
</div>
{% endblock %}
