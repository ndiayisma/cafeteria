{% extends 'base.html.twig' %}

{% block title %}Mon panier – CampusEats{% endblock %}

{% macro bouton(route, id, libelle, classe = '') %}
    <form class="inline" method="post" action="{{ path(route, {id: id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
        <input type="hidden" name="_retour" value="panier">
        <button type="submit" class="{{ classe }}">{{ libelle }}</button>
    </form>
{% endmacro %}

{% block body %}
    <h1>Mon panier</h1>

    {% if panier is empty %}
        <p>Ton panier est vide.</p>
        <a href="{{ path('app_menu') }}" role="button">Voir le menu</a>
    {% else %}
        <table>
            <thead>
                <tr><th>Plat</th><th>Prix</th><th>Quantité</th><th>Sous-total</th><th></th></tr>
            </thead>
            <tbody>
            {% for id, ligne in panier %}
                <tr>
                    <td>{{ ligne.nom }}</td>
                    <td>{{ ligne.prix|number_format(2, ',', ' ') }} €</td>
                    <td>
                        {{ _self.bouton('app_panier_retirer', id, '−', 'secondary') }}
                        <strong>&nbsp;{{ ligne.qte }}&nbsp;</strong>
                        {{ _self.bouton('app_panier_ajout', id, '+', 'secondary') }}
                    </td>
                    <td>{{ (ligne.prix * ligne.qte)|number_format(2, ',', ' ') }} €</td>
                    <td>{{ _self.bouton('app_panier_supprimer', id, 'Supprimer', 'outline contrast') }}</td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
                <tr><th colspan="3">Total</th><th colspan="2"><strong>{{ total|number_format(2, ',', ' ') }} €</strong></th></tr>
            </tfoot>
        </table>

        <a href="{{ path('app_menu') }}" role="button" class="secondary outline">Continuer mes achats</a>
        {# TODO étape 4 : retirer le test une fois la route app_commande_paiement créée #}
        {% if route_exists('app_commande_paiement') %}
            <a href="{{ path('app_commande_paiement') }}" role="button">Commander</a>
        {% else %}
            <button disabled>Commander</button>
        {% endif %}
    {% endif %}
{% endblock %}
